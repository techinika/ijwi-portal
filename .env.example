# GEMINI_API_KEY: Required if server-side Gemini AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this portal is hosted (used for callbacks and links).
APP_URL="http://localhost:3000"

# PESAPAL_MODE: "sandbox" or "live"
PESAPAL_MODE="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""
PESAPAL_CALLBACK_URL=""

# RESEND_API_KEY: Resend API key for transactional emails from noreply@mail.ijwi.me
RESEND_API_KEY=""
EMAIL_FROM="Ijwi <noreply@mail.ijwi.me>"
EMAIL_REPLY_TO="learn@ijwi.me"

# CLOUDFLARE_R2 (optional S3-compatible private bucket for production file storage)
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# INTERNAL_SIGNING_SECRET: Optional HMAC key for server-signed quotes and media stream tickets
INTERNAL_SIGNING_SECRET=""
