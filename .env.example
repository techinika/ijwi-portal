# GEMINI_API_KEY: Required if server-side Gemini AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this portal is hosted (used for callbacks and links).
APP_URL="http://localhost:3000"

# FIREBASE (Optional overrides for Vercel/production; defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# CLOUDFLARE WORKER BRIDGE (Connects this app to R2 private storage & Queue-backed email)
CF_WORKER_URL=""
CF_WORKER_SHARED_SECRET=""

# PESAPAL_MODE: "sandbox" or "live"
PESAPAL_MODE="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""
PESAPAL_CALLBACK_URL=""

# RESEND_API_KEY: Resend API key for transactional emails from noreply@mail.ijwi.me
RESEND_API_KEY=""
EMAIL_FROM="Ijwi <noreply@mail.ijwi.me>"
EMAIL_REPLY_TO="learn@ijwi.me"

# INTERNAL_SIGNING_SECRET: HMAC key for server-signed quotes and media stream tickets (set a 32+ char secret on Vercel)
INTERNAL_SIGNING_SECRET=""
